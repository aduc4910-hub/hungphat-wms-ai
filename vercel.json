{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{app_server.py,src/**,data/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__path__=/api/:path*"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__path__=/api"
    }
  ]
}
